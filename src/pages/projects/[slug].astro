---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Publication from '../../components/Publication.astro';
import pubs from '../../data/publications.json';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, category, cover, coverAlt, stack, papers, link } = project.data;
const related = pubs.publications.filter((p) => p.doi && papers.includes(p.doi));
---
<Base title={title} description={summary}>
  <article class="wrap">
    <p class="eyebrow"><a href="/projects/">Projects</a> / {category}</p>
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
    <p>{stack.map((s) => <span class="tag">{s}</span>)}</p>
    {link && <p><a href={link}>View the project →</a></p>}
    {cover && <Image src={cover} alt={coverAlt} width={1200} class="cover" />}
    <div class="prose"><Content /></div>
    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Related papers</h2></div>
        <ul class="plain">{related.map((p) => <Publication pub={p} />)}</ul>
      </section>
    )}
  </article>
</Base>
<style>
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--accent); }
  .cover { width: 100%; border-radius: 12px; border: 1px solid var(--line); margin: 2rem 0; background: #fff; }
  .plain { list-style: none; padding: 0; margin: 0; }
</style>
