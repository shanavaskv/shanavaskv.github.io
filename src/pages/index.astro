---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import portrait from '../assets/portrait.jpg';
import { profile, stats, expertise, work, experience, education } from '../data/profile';
import { byDateDesc } from '../lib/format';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(byDateDesc).slice(0, 3);

const icons: Record<string, string> = {
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  spark: 'M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z',
  people: 'M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20M10 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM20 20v-1.5a3.5 3.5 0 0 0-2.5-3.35M15.5 4.15a3.5 3.5 0 0 1 0 6.7',
  stack: 'M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17.5l9 5 9-5',
};
---
<Base>
  <div class="wrap wide">
    <section class="hero">
      <div class="glow" aria-hidden="true"></div>
      <div class="hero-text">
        <p class="pill"><span class="dot"></span>{profile.title} · {profile.subtitle}</p>
        <h1>Turning data and AI into <span class="grad">decisions that move the business.</span></h1>
        <p class="lede">I'm {profile.name}. {profile.intro}</p>
        <div class="cta">
          <a class="btn" href="#contact">Get in touch</a>
          <a class="btn btn-ghost" href="#work">See selected work</a>
        </div>
        <ul class="social">
          {profile.links.map((l) => <li><a href={l.href} rel="me">{l.label} ↗</a></li>)}
          <li class="muted">{profile.location}</li>
        </ul>
      </div>
      <div class="hero-photo">
        <Image src={portrait} alt={`Portrait of ${profile.name}`} width={320} height={320} densities={[1, 2]} loading="eager" />
      </div>
    </section>

    <section class="stats" aria-label="Impact">
      {stats.map((s) => (
        <div class="stat">
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </section>

    <section class="section about" id="about">
      <div class="about-grid">
        <div>
          <p class="eyebrow">About</p>
          <h2>From quantum materials to enterprise AI.</h2>
        </div>
        <div class="prose">{profile.bio.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="expertise">
        {expertise.map((e) => (
          <div class="card-base exp">
            <span class="ico" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icons[e.icon]} /></svg>
            </span>
            <h3>{e.title}</h3>
            <ul>{e.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="work">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Production AI with measurable results</h2>
        </div>
      </div>
      <div class="work">
        {work.map((w) => (
          <article class="card-base wcard">
            <p class="org">{w.org}</p>
            <p class="metric grad">{w.metric}</p>
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
            <p class="tags">{w.tags.map((t) => <span class="tag">{t}</span>)}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="experience">
      <div class="section-head">
        <div>
          <p class="eyebrow">Experience</p>
          <h2>Where I've worked</h2>
        </div>
      </div>
      <ol class="timeline">
        {experience.map((e) => (
          <li class="job">
            <div class="when">
              {e.roles.map((r) => <span>{r.period}</span>)}
            </div>
            <div class="what">
              <h3>{e.org}{e.place && <span class="place"> · {e.place}</span>}</h3>
              {e.roles.map((r) => <p class="role">{r.role}</p>)}
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
      <div class="edu">
        {education.map((e) => (
          <div class="card-base edu-item">
            <strong>{e.degree}</strong>
            <span>{e.org}</span>
            <span class="muted small">{e.note}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="research">
      <div class="section-head">
        <div>
          <p class="eyebrow">Research & side projects</p>
          <h2>Physics roots, early ML experiments</h2>
          <p>Before industry I spent 14 years in computational physics. A few highlights, plus the machine learning projects that started the switch.</p>
        </div>
        <a href="/publications/" class="more">All 29 papers →</a>
      </div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>

    <section class="section" id="writing">
      <div class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>Notes from the terminal</h2>
        </div>
        <a href="/writing/" class="more">All posts →</a>
      </div>
      <PostList posts={posts} />
    </section>

    <section class="section contact" id="contact">
      <div class="glow" aria-hidden="true"></div>
      <p class="eyebrow">Contact</p>
      <h2>Let's talk about data, AI and measurement.</h2>
      <p class="muted">Advisory, speaking, collaboration or just a hello. Email is the best way to reach me.</p>
      <div class="cta center">
        <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.links.map((l) => <a class="btn btn-ghost" href={l.href} rel="me">{l.label}</a>)}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; padding: clamp(2rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem); }
  .glow { position: absolute; inset: -10% -5% auto auto; width: 60%; height: 80%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent), radial-gradient(closest-side at 30% 70%, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent); filter: blur(40px); z-index: -1; pointer-events: none; }
  .pill { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.85rem; color: var(--muted); border: 1px solid var(--line); background: var(--surface); padding: 0.35rem 0.85rem; border-radius: 999px; margin: 0 0 1.5rem; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-2) 25%, transparent); }
  .hero h1 { font-size: clamp(2.3rem, 5.6vw, 4rem); line-height: 1.05; letter-spacing: -0.035em; margin-bottom: 1.25rem; }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.2rem); max-width: 36rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .cta.center { justify-content: center; }
  .social { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.92rem; }
  .social a { color: var(--text); text-decoration: none; }
  .social a:hover { color: var(--accent); }
  .hero-photo { justify-self: end; position: relative; }
  .hero-photo::before { content: ''; position: absolute; inset: -10px; border-radius: 32px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); opacity: 0.85; transform: rotate(4deg); z-index: -1; }
  .hero-photo img { width: min(320px, 100%); aspect-ratio: 1; object-fit: cover; border-radius: 28px; border: 4px solid var(--bg); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  .stat { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.5rem 1.5rem 1.6rem; border-left: 1px solid var(--line); }
  .stat:first-child { border-left: 0; }
  .stat strong { font: 700 clamp(1.8rem, 3.5vw, 2.4rem)/1 var(--display); letter-spacing: -0.03em; }
  .stat span { font-size: 0.88rem; color: var(--muted); line-height: 1.4; }

  .about-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 3rem; align-items: start; }
  .about-grid h2 { margin: 0; }
  .expertise { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .exp { padding: 1.4rem; }
  .ico { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 10px; background: var(--accent-soft); color: var(--accent); }
  .exp h3 { font-size: 1.05rem; margin: 1rem 0 0.6rem; }
  .exp ul { margin: 0; padding: 0; list-style: none; font-size: 0.9rem; color: var(--muted); }
  .exp li { padding: 0.3rem 0; border-top: 1px dashed var(--line); }
  .exp li:first-child { border-top: 0; }

  .work { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .wcard { padding: 1.5rem; display: flex; flex-direction: column; transition: transform 0.15s, border-color 0.15s; }
  .wcard:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .org { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 1rem; }
  .metric { font: 700 1.6rem/1.1 var(--display); letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .wcard h3 { font-size: 1.1rem; margin: 0 0 0.5rem; }
  .wcard .muted { font-size: 0.93rem; margin: 0 0 1rem; }
  .tags { margin: auto 0 0; }

  .timeline { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .job { display: grid; grid-template-columns: 12rem 1fr; gap: 2rem; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
  .when { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.88rem; color: var(--muted); font-variant-numeric: tabular-nums; padding-top: 0.2rem; }
  .what h3 { margin: 0 0 0.3rem; font-size: 1.2rem; }
  .place { font-weight: 400; color: var(--muted); font-size: 0.95rem; font-family: var(--sans); letter-spacing: 0; }
  .role { margin: 0; font-weight: 500; color: var(--accent); font-size: 0.97rem; }
  .what ul { margin: 0.75rem 0 0; padding-left: 1.1rem; color: var(--muted); font-size: 0.95rem; }
  .what li { margin-bottom: 0.3rem; }
  .edu { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .edu-item { padding: 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.2rem; }

  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .more { font-size: 0.92rem; white-space: nowrap; }

  .contact { position: relative; overflow: hidden; text-align: center; padding: clamp(3rem, 7vw, 5rem) 1.5rem; border: 1px solid var(--line); border-radius: 24px; background: var(--surface); box-shadow: var(--shadow); }
  .contact .glow { inset: -30% auto auto 20%; width: 60%; height: 120%; z-index: 0; }
  .contact > * { position: relative; }
  .contact h2 { margin: 0 auto 0.75rem; max-width: 30rem; }

  @media (max-width: 1000px) {
    .expertise, .grid { grid-template-columns: repeat(2, 1fr); }
    .work { grid-template-columns: repeat(2, 1fr); }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(3) { border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .hero-photo { order: -1; justify-self: start; }
    .hero-photo img { width: 112px; border-radius: 22px; }
    .hero-photo::before { inset: -6px; border-radius: 26px; }
    .about-grid, .job { grid-template-columns: 1fr; gap: 1rem; }
    .work, .edu { grid-template-columns: 1fr; }
    .section-head { flex-direction: column; align-items: start; }
  }
  @media (max-width: 520px) {
    .expertise, .grid { grid-template-columns: 1fr; }
    .stat { padding: 1.2rem; }
  }
</style>
