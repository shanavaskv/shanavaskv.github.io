---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import portrait from '../assets/portrait.jpg';
import { profile, experience, education } from '../data/profile';
import pubs from '../data/publications.json';
import { byDateDesc } from '../lib/format';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(byDateDesc).slice(0, 3);
---
<Base>
  <div class="wrap wide">
    <section class="hero">
      <div>
        <p class="eyebrow">{profile.title}</p>
        <h1>Hi, I'm {profile.shortName}.</h1>
        <p class="lede">{profile.intro}</p>
        <p class="cta">
          <a class="btn" href={`mailto:${profile.email}`}>Get in touch</a>
          {profile.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
        </p>
      </div>
      <Image src={portrait} alt={`Portrait of ${profile.name}`} width={240} height={240} densities={[1, 2]} class="portrait" loading="eager" />
    </section>

    <section class="section about" id="about">
      <div class="section-head"><h2>About</h2></div>
      <div class="cols">
        <div class="prose">
          {profile.bio.map((p) => <p>{p}</p>)}
        </div>
        <aside>
          <p class="eyebrow">Focus areas</p>
          <ul class="focus">{profile.focus.map((f) => <li>{f}</li>)}</ul>
          <div class="stats">
            <div><strong>{pubs.publications.length}</strong><span>journal papers</span></div>
            <div><strong>2</strong><span>patent disclosures</span></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="section-head"><h2>Projects</h2><a href="/projects/">All projects →</a></div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>

    <section class="section cols" id="experience">
      <div>
        <div class="section-head"><h2>Experience</h2></div>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <span class="period">{e.period}</span>
              <strong>{e.role}</strong>
              <span>{e.org}</span>
              <span class="muted small">{e.note}</span>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <div class="section-head"><h2>Education</h2></div>
        <ol class="timeline">
          {education.map((e) => (
            <li>
              <span class="period">{e.year}</span>
              <strong>{e.degree}</strong>
              <span>{e.org}</span>
              {e.note && <span class="muted small">Thesis: {e.note}</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="writing">
      <div class="section-head"><h2>Writing</h2><a href="/writing/">All posts →</a></div>
      <PostList posts={posts} />
    </section>

    <section class="section contact" id="contact">
      <h2>Say hello</h2>
      <p class="muted">The best way to reach me is by email at <a href={`mailto:${profile.email}`}>{profile.email}</a>.</p>
    </section>
  </div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; padding: 2rem 0 1rem; }
  .portrait { width: 240px; height: 240px; border-radius: 50%; object-fit: cover; border: 6px solid var(--surface); box-shadow: 0 0 0 1px var(--line); }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.75rem; }
  .btn { background: var(--accent); color: var(--bg); padding: 0.6rem 1.15rem; border-radius: 8px; text-decoration: none; font-weight: 500; }
  .btn:hover { filter: brightness(1.1); }
  .cols { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; }
  #experience.cols { grid-template-columns: 1fr 1fr; }
  .focus { padding-left: 1.1rem; margin: 0 0 1.5rem; color: var(--muted); }
  .focus li { margin-bottom: 0.4rem; }
  .stats { display: flex; gap: 2rem; }
  .stats div { display: flex; flex-direction: column; }
  .stats strong { font: 500 2.2rem/1 var(--serif); color: var(--accent); }
  .stats span { font-size: 0.85rem; color: var(--muted); margin-top: 0.3rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { display: flex; flex-direction: column; padding: 0 0 1.4rem 1.25rem; border-left: 2px solid var(--line); position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -6px; top: 0.35rem; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .period { font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .contact { text-align: center; padding: 3rem 1rem; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .contact h2 { margin-top: 0; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; gap: 2rem; }
    .hero .portrait { order: -1; width: 128px; height: 128px; }
    .cols, #experience.cols { grid-template-columns: 1fr; gap: 1.5rem; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
