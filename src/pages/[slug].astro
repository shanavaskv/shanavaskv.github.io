---
// Blog posts live at the site root (e.g. /ssh-tunnel/) so links from the old site keep working.
import 'katex/dist/katex.min.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fmtDate } from '../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const yearsOld = new Date().getFullYear() - date.getUTCFullYear();
---
<Base title={title} description={description}>
  <article class="wrap">
    <p class="eyebrow"><a href="/writing/">Writing</a> · <time datetime={date.toISOString()}>{fmtDate(date)}</time></p>
    <h1>{title}</h1>
    <p>{tags.map((t) => <span class="tag">{t}</span>)}</p>
    {yearsOld >= 5 && (
      <p class="note">This post is from {date.getUTCFullYear()}. Some commands and tools may have changed since.</p>
    )}
    <div class="prose"><Content /></div>
    <p class="back"><a href="/writing/">← All posts</a></p>
  </article>
</Base>
<style>
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--accent); }
  .note { font-size: 0.9rem; color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--accent); padding: 0.7rem 1rem; border-radius: 6px; margin: 1.5rem 0 2rem; }
  .back { margin-top: 3rem; }
</style>
