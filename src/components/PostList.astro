---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../lib/format';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
<ul class="posts">
  {posts.map((p) => (
    <li>
      <a href={`/${p.id}/`}>{p.data.title}</a>
      <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, { year: 'numeric', month: 'short' })}</time>
      <p class="muted small">{p.data.description}</p>
    </li>
  ))}
</ul>
<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  li:last-child { border-bottom: 0; }
  a { font: 500 1.15rem/1.35 var(--serif); color: var(--text); text-decoration: none; }
  a:hover { color: var(--accent); }
  time { color: var(--muted); font-size: 0.85rem; white-space: nowrap; padding-top: 0.2rem; font-variant-numeric: tabular-nums; }
  p { grid-column: 1 / -1; margin: 0.25rem 0 0; }
</style>
