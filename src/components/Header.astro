---
import { profile } from '../data/profile';
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/projects/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/writing/', label: 'Writing' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap wide bar">
    <a class="brand" href="/"><span class="mark" aria-hidden="true">SK</span>{profile.name}</a>
    <nav id="site-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={!n.href.startsWith('/#') && path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="contact" href="/#contact">Contact</a>
    </nav>
    <div class="actions">
      <button class="icon theme" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <button class="icon menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector('.theme')?.addEventListener('click', () => {
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  const menu = document.querySelector<HTMLButtonElement>('.menu');
  const header = document.querySelector('.site-header');
  const setOpen = (open: boolean) => {
    header?.classList.toggle('open', open);
    menu?.setAttribute('aria-expanded', String(open));
    menu?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menu?.addEventListener('click', () => setOpen(!header?.classList.contains('open')));
  document.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font: 600 1.02rem var(--display); letter-spacing: -0.01em; color: var(--text); text-decoration: none; margin-right: auto; }
  .mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 9px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-size: 0.75rem; letter-spacing: 0.02em; }
  nav { display: flex; align-items: center; gap: 0.25rem; font-size: 0.93rem; }
  nav a { color: var(--muted); text-decoration: none; padding: 0.4rem 0.7rem; border-radius: 999px; }
  nav a:hover { color: var(--text); background: var(--surface-2); }
  nav a[aria-current='page'] { color: var(--text); background: var(--surface-2); }
  nav .contact { color: var(--bg); background: var(--text); margin-left: 0.4rem; }
  nav .contact:hover { color: var(--bg); background: var(--text); opacity: 0.88; }
  .actions { display: flex; gap: 0.25rem; }
  .icon { background: none; border: 0; color: var(--muted); cursor: pointer; width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border-radius: 999px; }
  .icon:hover { color: var(--text); background: var(--surface-2); }
  .menu { display: none; }
  @media (max-width: 860px) {
    .menu { display: grid; }
    nav { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0.15rem; padding: 0.75rem 1rem 1.25rem; background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
    .open nav { display: flex; }
    nav a { padding: 0.75rem 0.9rem; border-radius: 10px; font-size: 1rem; }
    nav .contact { margin: 0.5rem 0 0; text-align: center; border-radius: 999px; }
  }
</style>
